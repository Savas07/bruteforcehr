# dependencies
node_modules/
.pnpm-store/

# build output
dist/
out/
build/
release/
!scripts/release/
.turbo/
coverage/
*.tsbuildinfo
# Tauri: Cargo build output and tauri-build's generated capability schemas (listed here, not in
# a nested .gitignore, so Prettier skips them too)
target/
apps/desktop/src-tauri/gen/

# Xcode / SwiftPM (apps/ios DerivedData goes to the ignored apps/ios/build/)
xcuserdata/
*.xcresult
.build/
.swiftpm/
*.ipa
*.dSYM.zip

# Astro
apps/web/.astro/

# Firebase
.firebase/
*-debug.log
firebase-debug.*.log
ui-debug.log
firestore-debug.log
apps/functions/lib/

# Mobbin images are third-party copyrighted screenshots: never commit (docs/BRIEF.md §5.2)
design-refs/

# screenshots captured for critique runs live outside git; critique text is committed
artifacts/

# secrets
.env
.env.*
!.env.example
# non-secret Cloud Functions params (Firebase convention: committed .env.<projectId>)
!apps/functions/.env.bruteforcehr
*.p8
*.p12
*.mobileprovision
service-account*.json
.secret.local

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
