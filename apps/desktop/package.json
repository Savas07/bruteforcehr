{
  "name": "@bfhr/desktop",
  "version": "0.5.0",
  "private": true,
  "description": "BruteForceHR desktop app for macOS and Windows (Tauri 2).",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:design": "pnpm --filter @bfhr/ui-tokens build && vite --mode design",
    "build": "vite build",
    "check:bundle": "vite build && node scripts/check-production-bundle.ts",
    "bundle": "tauri build",
    "bundle:app": "tauri build --bundles app",
    "build:e2e": "tauri build --features e2e --no-bundle --config src-tauri/tauri.e2e.conf.json",
    "build:e2e:design": "tauri build --features e2e --no-bundle --config src-tauri/tauri.e2e.conf.json --config src-tauri/tauri.design.conf.json",
    "test:e2e": "wdio run e2e/wdio.conf.ts",
    "capture": "wdio run e2e/wdio.capture.conf.ts",
    "capture:app:design": "wdio run e2e/wdio.capture-design.conf.ts",
    "capture:design": "node scripts/capture-design.ts",
    "perf:cold-start": "wdio run e2e/wdio.perf.conf.ts && node scripts/perf-cold-start.ts",
    "perf:scroll": "node scripts/perf-scroll.ts",
    "tauri": "tauri",
    "lint": "eslint .",
    "test": "vitest run && node scripts/i18n.ts check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "i18n:extract": "node scripts/i18n.ts extract",
    "i18n:check": "node scripts/i18n.ts check"
  },
  "dependencies": {
    "@bfhr/api": "workspace:*",
    "@bfhr/core": "workspace:*",
    "@bfhr/cv-render": "workspace:*",
    "@bfhr/ui-tokens": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "2.7.0",
    "cmdk": "^1.1.1",
    "firebase": "^13.1.0",
    "get-nonce": "^1.0.1",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intl": "^11.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@bfhr/fixtures": "workspace:*",
    "@formatjs/cli": "^6.16.35",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.5.0",
    "@wdio/tauri-service": "^1.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webdriverio": "^9.32.0"
  }
}
