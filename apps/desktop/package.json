{
  "name": "@bfhr/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "BruteForceHR desktop app for macOS and Windows (Tauri 2).",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "vite build",
    "bundle": "tauri build",
    "bundle:app": "tauri build --bundles app",
    "build:e2e": "tauri build --features e2e --no-bundle --config src-tauri/tauri.e2e.conf.json",
    "test:e2e": "wdio run e2e/wdio.conf.ts",
    "capture": "wdio run e2e/wdio.capture.conf.ts",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@bfhr/ui-tokens": "workspace:*",
    "@tanstack/react-router": "^1.170.45",
    "@tauri-apps/api": "^2.12.4",
    "cmdk": "^1.1.1",
    "get-nonce": "^1.0.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.5.0",
    "@wdio/tauri-service": "^1.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "webdriverio": "^9.32.0"
  }
}
