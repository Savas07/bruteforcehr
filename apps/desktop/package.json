{
  "name": "@bfhr/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "BruteForceHR desktop app for macOS and Windows (Electron).",
  "productName": "BruteForceHR",
  "author": "Savas07",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "package": "electron-vite build && electron-builder --publish never",
    "capture": "electron-vite build && tsx scripts/capture.ts",
    "test:e2e": "electron-vite build && playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.45",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cmdk": "^1.1.1",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "get-nonce": "^1.0.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  }
}
