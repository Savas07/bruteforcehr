{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BruteForceHR",
  "version": "../package.json",
  "identifier": "com.savas07.bruteforcehr",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm --filter @bfhr/ui-tokens build && pnpm exec vite",
    "beforeBuildCommand": "pnpm --filter @bfhr/ui-tokens build && pnpm exec vite build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://firestore.googleapis.com",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "object-src": "'none'"
      },
      "devCsp": {
        "default-src": "'none'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:5173 https://firestore.googleapis.com",
        "base-uri": "'none'",
        "form-action": "'none'",
        "object-src": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "copyright": "Copyright © 2026 Savas07",
    "publisher": "Savas07",
    "shortDescription": "Job search, CVs and application tracking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzOTc3NEI4NkNBOENCRTkKUldUcHk2aHN1SFNYdytldk1DdHN2Y3RrTUlxdFB3NnZoVVM0TEpuWHZlTGhINVdTWWlsUzBUTysK",
      "endpoints": ["https://github.com/Savas07/bruteforcehr/releases/latest/download/latest.json"],
      "betaEndpoints": ["https://github.com/Savas07/bruteforcehr/releases/download/updater-beta/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
