{
  "name": "@bfhr/functions",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Cloud Functions for Firebase (gen2, europe-west1). Bundled with esbuild into lib/<codebase>/ for deploy.",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only auth,firestore,storage --project demo-bruteforcehr \"vitest run -c vitest.emulator.config.ts\"",
    "chromium:local": "tsx scripts/local-chromium.ts",
    "print:local": "tsx scripts/print-local.ts",
    "smoke:account": "tsx scripts/smoke-account.ts",
    "smoke:ai": "node scripts/smoke-ai.ts",
    "smoke:jobs": "tsx scripts/smoke-jobs.ts",
    "smoke:mail": "tsx scripts/smoke-mail.ts",
    "smoke:render": "tsx scripts/smoke-render.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@bfhr/ai": "workspace:*",
    "@bfhr/api": "workspace:*",
    "@bfhr/core": "workspace:*",
    "@bfhr/cv-render": "workspace:*",
    "@bfhr/jobs-connectors": "workspace:*",
    "@sparticuz/chromium": "153.0.0",
    "fflate": "^0.8.3",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^11.3.1",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.2.1",
    "pdfjs-dist": "^6.4.299",
    "puppeteer-core": "25.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bfhr/fixtures": "workspace:*",
    "@puppeteer/browsers": "3.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "firebase-tools": "~15.34.0",
    "imapkit": "^5.2.0",
    "smtp-server": "^3.21.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
