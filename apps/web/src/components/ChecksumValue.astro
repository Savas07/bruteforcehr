---
/**
 * SHA-256 of a download (website.md › ChecksumValue + CopyButton): the full value in mono, wrapping
 * anywhere, with a Copy button. The button is added by script, so without JavaScript only the
 * selectable value shows; the confirmation is announced through a polite live region.
 */
interface Props {
  sha256: string;
  fileName: string;
}

const { sha256, fileName } = Astro.props;
---

<div class="checksum mt-3">
  <div class="flex items-center justify-between gap-3">
    <span class="text-subheadline font-semibold text-fg-secondary">SHA-256</span>
    <button
      type="button"
      class="copy-checksum button button-secondary min-h-11 px-4 text-subheadline"
      data-value={sha256}
      aria-label={`Copy SHA-256 of ${fileName}`}
      hidden
    >
      Copy
    </button>
  </div>
  <code class="mt-1 block font-mono text-footnote break-all text-fg-primary">{sha256}</code>
  <span class="copy-status sr-only" aria-live="polite"></span>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".copy-checksum")) {
    const status = button.closest(".checksum")?.querySelector(".copy-status");
    button.hidden = !("clipboard" in navigator);
    button.addEventListener("click", () => {
      void navigator.clipboard.writeText(button.dataset.value ?? "").then(
        () => {
          button.textContent = "Copied";
          if (status) status.textContent = "Checksum copied";
          setTimeout(() => {
            button.textContent = "Copy";
            if (status) status.textContent = "";
          }, 2000);
        },
        () => {
          if (status) status.textContent = "Couldn't copy. Select the checksum and copy it instead.";
        },
      );
    });
  }
</script>
