---
/** Line icons for the platform rows (generic device shapes, not vendor logos). Decorative. */
interface Props {
  platform: "mac" | "windows" | "iphone";
  class?: string;
}

const { platform, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {platform === "mac" && <path d="M5 6.5A1.5 1.5 0 0 1 6.5 5h11A1.5 1.5 0 0 1 19 6.5V16H5V6.5ZM3 16h18v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1Z" />}
  {platform === "windows" && <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 14.5v-9ZM9 20h6M12 16v4" />}
  {platform === "iphone" && <path d="M8.5 3h7A1.5 1.5 0 0 1 17 4.5v15a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 7 19.5v-15A1.5 1.5 0 0 1 8.5 3ZM11 18h2" />}
</svg>
