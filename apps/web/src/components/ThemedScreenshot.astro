---
/**
 * App screenshot that follows the visitor's colour scheme (website.md › DeviceBento: light/dark
 * `<picture>` sources). Both variants are resized to `widths` at build time; the browser downloads
 * only the one for its scheme and width.
 */
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  /** Above the fold: load immediately with high priority (Largest Contentful Paint candidate). */
  priority?: boolean;
  class?: string;
}

const { light, dark, alt, widths, sizes, priority = false, class: className } = Astro.props;
const [lightImage, darkImage] = await Promise.all([
  getImage({ src: light, widths, format: "webp" }),
  getImage({ src: dark, widths, format: "webp" }),
]);
---

<picture>
  <source media="(prefers-color-scheme: dark)" srcset={darkImage.srcSet.attribute} sizes={sizes} type="image/webp" />
  <img
    src={lightImage.src}
    srcset={lightImage.srcSet.attribute}
    sizes={sizes}
    width={light.width}
    height={light.height}
    alt={alt}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
    class={className}
  />
</picture>
