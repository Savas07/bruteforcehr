---
import "../styles/global.css";
import { DEFAULT_LOCALE, SITE_NAME, THEME_COLOR } from "../site.ts";

interface Props {
  /** Page title; omitted on the home page, where the site name stands alone. */
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const lang = Astro.currentLocale ?? DEFAULT_LOCALE;
const fullTitle = title === undefined ? SITE_NAME : `${title} · ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={THEME_COLOR.light} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={THEME_COLOR.dark} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    <!--
      Download buttons follow the visitor's system (website.md › Decision — Desktop). Set before
      first paint so the matching variant shows without a layout shift; nothing is stored or sent.
    -->
    <script is:inline>
      (() => {
        const ua = navigator.userAgent;
        // `userAgentData.platform` says "macOS" / "Windows"; `navigator.platform` "MacIntel" / "Win32".
        const platform = navigator.userAgentData?.platform ?? navigator.platform ?? "";
        const isMac = /^mac/i.test(platform);
        // iPadOS reports a Mac platform; touch support tells them apart.
        const os =
          /iPhone|iPad|iPod/.test(ua) || (isMac && navigator.maxTouchPoints > 1)
            ? "ios"
            : isMac
              ? "mac"
              : /^win/i.test(platform)
                ? "windows"
                : undefined;
        if (os !== undefined) document.documentElement.dataset.os = os;
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-dvh antialiased">
    <slot />
  </body>
</html>
