---
/**
 * One User guide topic (website.md › User guide). Breadcrumb, title and lead (Intercom), an optional
 * screenshot, then the article. From 1280 px the topics sit in a sticky column on the left with the
 * current topic's sections nested under it (Steep, Attio); below 1280 px "On this page" is an inline
 * box under the title, and every page ends with previous / next topics. English only, like the legal
 * pages (decisions.md U3). Title and description come from `GUIDE_PAGES`, so the navigation, the
 * overview and the page can't disagree.
 */
import ThemedScreenshot from "../components/ThemedScreenshot.astro";
import { GUIDE_PAGES } from "../guide/pages.ts";
import { screens } from "../screens.ts";
import SiteLayout from "./SiteLayout.astro";

interface Props {
  /** Markdown pages get these from Astro; `.astro` topics pass their `h2`s themselves. */
  headings: readonly { depth: number; slug: string; text: string }[];
}

const path = Astro.url.pathname.replace(/\/?$/u, "/");
const index = GUIDE_PAGES.findIndex((candidate) => candidate.href === path);
const page = GUIDE_PAGES[index];
if (!page) throw new Error(`${path} is not listed in src/guide/pages.ts`);
const previous = GUIDE_PAGES[index - 1];
const next = GUIDE_PAGES[index + 1];
const sections = Astro.props.headings.filter((heading) => heading.depth === 2);
const screen = page.screen === undefined ? undefined : screens[page.screen];
---

<SiteLayout title={`${page.title} · User guide`} description={page.description}>
  <div class="mx-auto max-w-6xl px-5 pt-10 md:px-6 md:pt-16 xl:grid xl:grid-cols-[15rem_minmax(0,1fr)] xl:gap-x-16">
    <nav
      aria-label="User guide"
      class="hidden xl:sticky xl:top-24 xl:col-start-1 xl:row-span-2 xl:row-start-1 xl:block xl:max-h-[calc(100dvh-7rem)] xl:self-start xl:overflow-y-auto"
    >
      <a href="/guide/" class="guide-nav-link font-mono text-subheadline text-fg-tertiary">User guide</a>
      <ul class="mt-1">
        {
          GUIDE_PAGES.map((topic) => (
            <li>
              <a href={topic.href} class="guide-nav-link" aria-current={topic.href === path ? "page" : undefined}>
                {topic.title}
              </a>
              {topic.href === path && sections.length > 0 && (
                <ul class="mb-2 ml-3 border-l border-line-subtle pl-3">
                  {sections.map((section) => (
                    <li>
                      <a href={`#${section.slug}`} class="guide-nav-link guide-nav-section">
                        {section.text}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="min-w-0 xl:col-start-2">
      <header class="max-w-[68ch]">
        <nav aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-x-2 text-subheadline text-fg-secondary">
            <li>
              <a href="/guide/" class="prose-link inline-flex min-h-11 items-center">User guide</a>
            </li>
            <li class="flex items-center gap-2">
              <span aria-hidden="true" class="text-fg-tertiary">›</span>
              <span aria-current="page">{page.title}</span>
            </li>
          </ol>
        </nav>
        <h1 class="mt-2 font-display text-display text-fg-primary">{page.title}</h1>
        <p class="mt-4 text-lead text-fg-secondary">{page.description}</p>
      </header>

      {
        sections.length > 0 && (
          <nav
            aria-labelledby="on-this-page"
            class="mt-8 max-w-[68ch] rounded-lg border border-line-subtle bg-surface-base p-5 xl:hidden"
          >
            <h2 id="on-this-page" class="font-mono text-subheadline text-fg-tertiary">
              On this page
            </h2>
            <ul class="mt-2 gap-x-8 md:columns-2">
              {sections.map((section) => (
                <li class="break-inside-avoid">
                  <a href={`#${section.slug}`} class="guide-nav-link">
                    {section.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        screen && (
          <figure class="mt-10 max-w-4xl">
            <ThemedScreenshot
              light={screen.light}
              dark={screen.dark}
              alt={screen.alt}
              widths={[480, 800, 1280]}
              sizes="(min-width: 1280px) 820px, (min-width: 768px) 90vw, 92vw"
              priority
              class="h-auto w-full rounded-lg border border-line-subtle shadow-raised"
            />
            <figcaption class="mt-3 text-subheadline text-fg-tertiary">{screen.device} · sample data</figcaption>
          </figure>
        )
      }

      <article class="guide-prose mt-10">
        <slot />
      </article>

      <nav aria-label="More topics" class="mt-16 grid max-w-[68ch] gap-3 border-t border-line-subtle pt-8 md:grid-cols-2">
        {
          previous && (
            <a href={previous.href} class="guide-pager">
              <span class="text-subheadline text-fg-secondary">Previous</span>
              <span class="text-headline text-fg-primary">{previous.title}</span>
            </a>
          )
        }
        {
          next && (
            <a href={next.href} class="guide-pager md:col-start-2 md:text-end">
              <span class="text-subheadline text-fg-secondary">Next</span>
              <span class="text-headline text-fg-primary">{next.title}</span>
            </a>
          )
        }
      </nav>
      <p class="mt-8 max-w-[68ch] text-prose text-fg-secondary">
        Something not covered here? <a class="prose-link" href="/support/">Ask on the Support page</a>.
      </p>
    </div>
  </div>
</SiteLayout>
