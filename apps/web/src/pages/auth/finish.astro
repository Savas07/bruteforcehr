---
/**
 * Sign-in link landing page (docs/adr/0008-auth-email-link.md). Firebase Authentication's email link
 * ends here in the browser as `/auth/finish?apiKey=…&oobCode=…&mode=signIn&lang=…`. Nothing signs in
 * in the browser: the page hands the whole URL to the desktop app as
 * `bruteforcehr://auth/finish?link=<URL-encoded URL>` (tauri-plugin-deep-link, ADR 0006) and keeps a
 * calm fallback on screen. Copy follows the app's language from Firebase's `lang` parameter
 * (EN, TR with "siz", DE with "du"). Research and critique:
 * docs/design/research/onboarding-signin.md › Sign-in link landing page,
 * docs/design/critiques/web/auth-finish/.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Wordmark from "../../components/Wordmark.astro";
---

<BaseLayout title="Finish signing in" description="Finish signing in to the BruteForceHR app.">
  <meta slot="head" name="robots" content="noindex" />
  <meta slot="head" name="referrer" content="no-referrer" />
  <div class="flex min-h-dvh flex-col px-5 md:px-6">
    <header class="mx-auto flex w-full max-w-xl pt-6 md:pt-10">
      <a href="/" class="flex min-h-11 items-center rounded-full text-fg-primary">
        <Wordmark gradientId="bfhr-wordmark-finish" class="h-6 w-auto" />
      </a>
    </header>

    <main id="main" class="mx-auto flex w-full max-w-xl flex-1 flex-col justify-center py-12">
      <!-- Link present: the script fills in the deep link and shows this state. -->
      <section id="handoff" aria-labelledby="handoff-title" hidden>
        <h1 id="handoff-title" class="font-display text-title1 text-fg-primary" data-i18n="title">
          Opening BruteForceHR
        </h1>
        <p class="mt-4 text-lead text-fg-secondary" data-i18n="prompt">
          Your browser may ask to open the app. Choose Open to finish signing in.
        </p>
        <p class="mt-8">
          <a id="return-link" class="button button-primary button-large" data-i18n="cta">Return to BruteForceHR</a>
        </p>

        <div class="mt-10 space-y-4 border-t border-line-subtle pt-6 text-prose text-fg-secondary">
          <p>
            <span class="font-semibold text-fg-primary" data-i18n="notOpenedLead">Didn't open?</span>{" "}
            <span class="hyphens-manual" data-i18n="notOpened">Make sure the BruteForceHR app is installed on this computer.</span>{" "}
            <a class="prose-link hyphens-manual" href="/download/" data-i18n="download">Download BruteForceHR</a>
          </p>
          <p data-i18n="device">
            Open the link on the device where you asked for it. If you asked on your iPhone or another computer,
            open the email there.
          </p>
          <p class="text-subheadline" data-i18n="browser">
            You won't be signed in to this browser. You can close this tab once the app is open.
          </p>
        </div>
      </section>

      <!-- No usable link (opened without its parameters, or JavaScript is off). -->
      <section id="incomplete" aria-labelledby="incomplete-title">
        <h1 id="incomplete-title" class="font-display text-title1 text-fg-primary" data-i18n="incompleteTitle">
          This link isn't complete
        </h1>
        <p class="mt-4 text-lead text-fg-secondary" data-i18n="incompleteBody">
          Open the sign-in link from your email again. If it still doesn't work, ask for a new link in the app.
        </p>
        <noscript>
          <p class="mt-4 text-prose text-fg-secondary">
            This page needs JavaScript to pass the sign-in link to the app. Turn it on, then open the link again.
          </p>
        </noscript>
        <p class="mt-8">
          <a class="button button-secondary" href="/support/#signing-in" data-i18n="help">Get help with signing in</a>
        </p>
      </section>
    </main>
  </div>
  <!--
    A classic same-origin script (not bundled, not inline: the Hosting CSP) so it runs before first
    paint: the hand-off state replaces the "incomplete" fallback without a flash, and the app opens
    as early as possible.
  -->
  <script is:inline src="/scripts/auth-finish.js"></script>
</BaseLayout>
