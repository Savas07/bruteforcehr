---
import SiteLayout from "../layouts/SiteLayout.astro";
import { SITE_DESCRIPTION, SITE_NAME } from "../site.ts";
---

<SiteLayout description={SITE_DESCRIPTION}>
  <div class="mx-auto max-w-6xl px-5 pt-10 md:px-6 md:pt-16">
    <h1 class="font-display text-display text-fg-primary">{SITE_NAME}</h1>
    <p class="mt-4 max-w-[60ch] text-lead text-fg-secondary">{SITE_DESCRIPTION}</p>
  </div>
</SiteLayout>
