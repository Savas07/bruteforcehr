rules_version = '2';

// Deny by default: a path is accessible only if a rule below allows it. Cloud Functions use the
// Admin SDK, which bypasses these rules. Client permissions follow docs/adr/0002-data-model.md
// and mirror the policy constants in @bfhr/core (policy.ts); every invariant is proven in
// firebase/tests.
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with a verified email: email-link sign-in always verifies the address
    // (docs/adr/0008-auth-email-link.md). The Email provider also accepts password sign-ups through
    // the public API; those accounts are unverified and get no data access (account pre-seeding).
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    // Fields of an update that the client changed (added, removed or modified).
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /users/{uid} {
      // Profile. Account deletion is server-side (recursive delete).
      allow read, create, update: if isOwner(uid);

      // Owner-managed collections without extra invariants.
      match /{collection}/{docId} {
        allow read, write: if isOwner(uid)
          && collection in ['coverLetters', 'savedSearches', 'interviews', 'contacts', 'devices'];
      }

      // Rendered PDF/DOCX metadata: immutable, its sha256 identifies the bytes an application used.
      match /renderedFiles/{fileId} {
        allow read, create: if isOwner(uid);
      }

      // Jobs: the embedding vector (JOB_EMBEDDING_FIELD) is written by the server only.
      match /jobs/{jobId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && !('embedding' in request.resource.data);
        allow update: if isOwner(uid) && !changedKeys().hasAny(['embedding']);
      }

      // Computed server-side. Clients only save or dismiss (JOB_MATCH_CLIENT_UPDATABLE_FIELDS).
      match /jobMatches/{jobId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && changedKeys().hasOnly(['state', 'dismissReasons', 'stateChangedAt'])
          && request.resource.data.state in ['new', 'saved', 'dismissed'];
      }

      // Applications. Once `appliedAt` is set, the pins recording the exact CV and cover letter
      // used are write-once (null → value only), and `appliedAt` can't be cleared to reopen them.
      function pinKept(field) {
        return resource.data.get(field, null) == null
          || request.resource.data.get(field, null) == resource.data.get(field, null);
      }

      // `emailSend` (decisions.md F6) is written only by the mail functions: clients create it as
      // null (or leave it out) and never change it.
      match /applications/{applicationId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.get('emailSend', null) == null;
        allow update: if isOwner(uid)
          && request.resource.data.get('emailSend', null) == resource.data.get('emailSend', null)
          && (resource.data.get('appliedAt', null) == null
            || (request.resource.data.get('appliedAt', null) != null
              && pinKept('cvRevisionId')
              && pinKept('cvFileId')
              && pinKept('coverLetterId')
              && pinKept('coverLetterFileId')));
      }

      // CVs: optimistic concurrency. Every write bumps `version` by exactly one, so a client
      // holding a stale copy fails instead of overwriting a newer edit. Archived, never deleted.
      match /cvs/{cvId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.version == 1;
        allow update: if isOwner(uid)
          && request.resource.data.version is int
          && request.resource.data.version == resource.data.version + 1;

        // Revisions are immutable snapshots; "restore" creates a new one.
        match /revisions/{revisionId} {
          allow read, create: if isOwner(uid);
        }
      }

      // Append-only history. Clients write user actions (CLIENT_EVENT_ACTORS); rule and AI events
      // are server-written. Undo is a new event that points at the original (`revertsEventId`).
      match /applicationEvents/{eventId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.actor == 'user';
      }

      // Mail connection status; credentials live under serverOnly/**.
      match /mailAccounts/{accountId} {
        allow read: if isOwner(uid);
      }

      // Written by the mail worker. Clients only review them (MAIL_MESSAGE_CLIENT_UPDATABLE_FIELDS,
      // MAIL_REVIEW_CLIENT_STATES): every client write is a review act, so the resulting reviewState
      // must be one a client may set (a no-op "pending" write fails too).
      match /mailMessages/{messageId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && changedKeys().hasOnly(['reviewState', 'applicationId', 'category', 'reviewedAt'])
          && request.resource.data.reviewState in ['confirmed', 'corrected', 'dismissed'];
      }
    }

    // Per-platform client config (minimum version, feature flags). Server-written.
    match /appConfig/{platform} {
      allow read: if true;
    }

    // Encrypted mail tokens and other server state: no client access. No rule matches
    // serverOnly/**, so the default deny applies; listed here for explicitness.
    match /serverOnly/{document=**} {
      allow read, write: if false;
    }
  }
}
