rules_version = '2';

// Deny by default. Users read only their own files and upload only CV documents of the allowed
// types and sizes. Uploads are immutable (no overwrite, no client delete): renderedFiles and CV
// imports reference exact bytes (docs/adr/0002-data-model.md); deletion is server-side (account
// delete, purge). Cloud Functions use the Admin SDK, which bypasses these rules.
service firebase.storage {
  match /b/{bucket}/o {

    // Verified email only, as in firestore.rules (docs/adr/0008-auth-email-link.md).
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    // `resource == null`: the object must not exist yet, so a client can never overwrite bytes that a
    // renderedFile or import already references.
    function isUpload(maxBytes, contentTypes) {
      return resource == null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType in contentTypes;
    }

    function pdfOrDocx() {
      return [
        'application/pdf',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
      ];
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
    }

    // CV import sources: PDF, DOCX, JSON Resume, LinkedIn data-export ZIP (Windows browsers report
    // ZIP files as application/x-zip-compressed).
    match /users/{uid}/cv-imports/{fileId} {
      allow create: if isOwner(uid)
        && isUpload(20 * 1024 * 1024, pdfOrDocx().concat([
          'application/json',
          'application/zip',
          'application/x-zip-compressed'
        ]));
    }

    // CVs and cover letters rendered on the desktop (DOCX/PDF export).
    match /users/{uid}/rendered/{fileId} {
      allow create: if isOwner(uid) && isUpload(10 * 1024 * 1024, pdfOrDocx());
    }
  }
}
