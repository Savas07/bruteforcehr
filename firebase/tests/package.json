{
  "name": "@bfhr/firebase-rules-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Firestore and Cloud Storage security rules tests. Needs the Firebase emulators (Java), so they run in CI only.",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-bruteforcehr \"vitest run\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.5",
    "firebase": "^12.19.0",
    "firebase-tools": "~15.34.0",
    "vitest": "^5.0.5"
  }
}
