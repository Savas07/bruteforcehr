{
  "name": "@bfhr/cv-render",
  "version": "0.2.1",
  "private": true,
  "description": "One CV renderer: JSON Resume + meta + template + theme → self-contained, ATS-safe HTML (desktop, iOS via JavaScriptCore, server Chromium), DOCX and JSON export.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./iife": "./dist/cv-render.iife.js"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "fonts": "node scripts/fonts.ts",
    "critique": "tsx scripts/critique.ts",
    "parity": "tsx scripts/parity.ts",
    "parity:server": "tsx scripts/parity-server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bfhr/core": "workspace:*",
    "docx": "~9.13.0"
  },
  "devDependencies": {
    "@bfhr/fixtures": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
