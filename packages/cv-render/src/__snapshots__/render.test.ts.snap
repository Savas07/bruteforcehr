exports[`renderCvHtml > compact: stable structure (snapshot) > compact-de 1`] = `"<!doctype html><html lang="de"><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; font-src data:; img-src data:"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="generator" content="BruteForceHR cv-render 0.1.0"><title>Deniz Aksoy – Lebenslauf</title><style>…</style></head><body><main class="cv cv--compact" data-template="compact"><header class="cv-header" data-cv-path="/basics"><div class="cv-id"><h1 class="cv-name" data-cv-path="/basics/name">Deniz Aksoy</h1><p class="cv-label" data-cv-path="/basics/label">Frontend- &amp; Product-Engineer</p><p class="cv-contact"><span data-cv-path="/basics/location">Istanbul, Türkei</span><span class="cv-sep"> · </span><a href="mailto:deniz.aksoy@example.com" data-cv-path="/basics/email">deniz.aksoy@example.com</a><span class="cv-sep"> · </span><a href="tel:+905325550147" data-cv-path="/basics/phone">+90 532 555 01 47</a><span class="cv-sep"> · </span><a href="https://deniz.example.com" data-cv-path="/basics/url">deniz.example.com</a><span class="cv-sep"> · </span><a href="https://github.com/deniz-aksoy-example" data-cv-path="/basics/profiles/0/url">github.com/deniz-aksoy-example</a><span class="cv-sep"> · </span><a href="https://www.linkedin.com/in/deniz-aksoy-example" data-cv-path="/basics/profiles/1/url">linkedin.com/in/deniz-aksoy-example</a></p></div></header><section class="cv-section" data-cv-section="summary" data-cv-path="/basics/summary"><div class="cv-keep"><h2 class="cv-heading">PROFIL</h2><div class="cv-text" data-cv-path="/basics/summary"><p>Frontend-Engineer mit fünf Jahren Erfahrung in React und TypeScript und Schwerpunkt auf Designsystemen und Barrierefreiheit – passend zu Tannenbaums Plattform für den Mittelstand. Ich bringe Erfahrung mit B2B-Oberflächen, Lokalisierung und messbaren Performance-Zielen mit.</p></div></div></section><section class="cv-section" data-cv-section="work" data-cv-path="/work"><div class="cv-keep"><h2 class="cv-heading">BERUFSERFAHRUNG</h2><article class="cv-entry is-short" data-cv-path="/work/0"><div class="cv-entry-head"><h3 class="cv-entry-title"><span class="cv-entry-role" data-cv-path="/work/0/position">Frontend Engineer</span><span class="cv-entry-org">, </span><span class="cv-entry-org" data-cv-path="/work/0/name">Pazarbox</span></h3><span class="cv-dates">März 2022 – heute</span></div><p class="cv-entry-sub"><span class="cv-entry-location" data-cv-path="/work/0/location">Istanbul, Türkei</span></p><p class="cv-entry-summary" data-cv-path="/work/0/summary">E-Commerce-Marktplatz mit 4 Mio. monatlichen Käufer:innen; Mitglied der Checkout- und Plattform-Squads.</p><ul class="cv-bullets"><li data-cv-path="/work/0/highlights/0">Neuaufbau des Designsystems geleitet (62 Komponenten, React + TypeScript, Storybook), von 7 Produktteams genutzt.</li><li data-cv-path="/work/0/highlights/1">Largest Contentful Paint im Checkout durch Code-Splitting und Bildbudgets von 3,9 s auf 1,8 s gesenkt.</li><li data-cv-path="/work/0/highlights/2">Visuelle Playwright-Tests eingeführt, die im ersten Quartal über 40 Regressionen vor dem Release fanden.</li><li data-cv-path="/work/0/highlights/3">Rechts-nach-links-Layout und arabische Lokalisierung für die Expansion in die Golfstaaten umgesetzt.</li></ul></article></div><article class="cv-entry is-short" data-cv-path="/work/1"><div class="cv-entry-head"><h3 class="cv-entry-title"><span class="cv-entry-role" data-cv-path="/work/1/position">Frontend Developer</span><span class="cv-entry-org">, </span><span class="cv-entry-org" data-cv-path="/work/1/name">Kuzey Labs</span></h3><span class="cv-dates">Feb. 2020 – Feb. 2022</span></div><p class="cv-entry-sub"><span class="cv-entry-location" data-cv-path="/work/1/location">Istanbul, Türkei</span></p><p class="cv-entry-summary" data-cv-path="/work/1/summary">Produktstudio für Web- und Mobile-Apps von Fintech- und Logistikkunden.</p><ul class="cv-bullets"><li data-cv-path="/work/1/highlights/0">React-Native-Fahrer-App für einen Logistikkunden entwickelt, täglich von 3.500 Fahrer:innen genutzt.</li><li data-cv-path="/work/1/highlights/1">GraphQL-basiertes Portfolio-Dashboard für eine türkische Neobank in vier Monaten ausgeliefert.</li></ul></article></section><section class="cv-section" data-cv-section="skills" data-cv-path="/skills"><div class="cv-keep"><h2 class="cv-heading">KENNTNISSE</h2><div class="cv-lines"><p data-cv-path="/skills/0"><span class="cv-line-label" data-cv-path="/skills/0/name">Frontend:</span> <span data-cv-path="/skills/0/keywords">React, TypeScript, Next.js, Redux, Tailwind CSS, Vite</span></p><p data-cv-path="/skills/1"><span class="cv-line-label" data-cv-path="/skills/1/name">Qualität:</span> <span data-cv-path="/skills/1/keywords">Barrierefreiheit (WCAG 2.2), Web-Performance, Jest, Playwright, Storybook</span></p><p data-cv-path="/skills/2"><span class="cv-line-label" data-cv-path="/skills/2/name">Produkt:</span> <span data-cv-path="/skills/2/keywords">Designsysteme, Figma, A/B-Tests, Lokalisierung</span></p></div></div></section><section class="cv-section" data-cv-section="education" data-cv-path="/education"><div class="cv-keep"><h2 class="cv-heading">AUSBILDUNG</h2><article class="cv-entry is-short" data-cv-path="/education/0"><div class="cv-entry-head"><h3 class="cv-entry-title"><span class="cv-entry-role" data-cv-path="/education/0">B.Sc., Technische Informatik</span><span class="cv-entry-org">, </span><span class="cv-entry-org" data-cv-path="/education/0/institution">Istanbul Technical University</span></h3><span class="cv-dates">Sept. 2015 – Juni 2019</span></div></article></div></section><section class="cv-section" data-cv-section="languages" data-cv-path="/languages"><div class="cv-keep"><h2 class="cv-heading">SPRACHEN</h2><div class="cv-lines"><p data-cv-path="/languages/0"><span class="cv-line-label" data-cv-path="/languages/0/language">Türkisch:</span> <span data-cv-path="/languages/0/fluency">Muttersprache</span></p><p data-cv-path="/languages/1"><span class="cv-line-label" data-cv-path="/languages/1/language">Englisch:</span> <span data-cv-path="/languages/1/fluency">Verhandlungssicher (C1)</span></p><p data-cv-path="/languages/2"><span class="cv-line-label" data-cv-path="/languages/2/language">Deutsch:</span> <span data-cv-path="/languages/2/fluency">Grundkenntnisse (A2)</span></p></div></div></section><section class="cv-section" data-cv-section="custom:vortraege" data-cv-path="/meta/customSections/0"><div class="cv-keep"><h2 class="cv-heading">VORTRÄGE</h2><article class="cv-entry is-short" data-cv-path="/meta/customSections/0/items/0"><div class="cv-entry-head"><h3 class="cv-entry-title"><span class="cv-entry-role" data-cv-path="/meta/customSections/0/items/0/title">Designsysteme, die sieben Teams überstehen</span><span class="cv-entry-org">, </span><span class="cv-entry-org" data-cv-path="/meta/customSections/0/items/0/subtitle">Frontend Istanbul Meetup</span></h3><span class="cv-dates">Apr. 2025</span></div></article></div></section></main></body></html>"`;

