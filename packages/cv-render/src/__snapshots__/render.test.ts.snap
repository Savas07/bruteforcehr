exports[`renderCvHtml > compact: stable structure (snapshot) > compact-en 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; font-src data:; img-src data:"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="generator" content="BruteForceHR cv-render 0.1.0"><title>Deniz Aksoy – CV</title><style>…</style></head><body><main class="cv cv--compact" data-template="compact"><header class="cv-header" data-cv-path="/basics"><div class="cv-id"><h1 class="cv-name" data-cv-path="/basics/name">Deniz Aksoy</h1><p class="cv-label" data-cv-path="/basics/label">Frontend &amp; Product Engineer</p><p class="cv-contact"><span data-cv-path="/basics/location">Istanbul, Türkiye</span><span class="cv-sep"> · </span><a href="mailto:deniz.aksoy@example.com" data-cv-path="/basics/email">deniz.aksoy@example.com</a><span class="cv-sep"> · </span><a href="tel:+905325550147" data-cv-path="/basics/phone">+90 532 555 01 47</a><span class="cv-sep"> · </span><a href="https://deniz.example.com" data-cv-path="/basics/url">deniz.example.com</a><span class="cv-sep"> · </span><a href="https://github.com/deniz-aksoy-example" data-cv-path="/basics/profiles/0/url">github.com/deniz-aksoy-example</a><span class="cv-sep"> · </span><a href="https://www.linkedin.com/in/deniz-aksoy-example" data-cv-path="/basics/profiles/1/url">linkedin.com/in/deniz-aksoy-example</a></p></div></header><section class="cv-section" data-cv-section="summary" data-cv-path="/basics/summary"><div class="cv-keep"><h2 class="cv-heading">SUMMARY</h2><div class="cv-text" data-cv-path="/basics/summary"><p>Frontend engineer with five years of experience building fast, accessible product UIs in React and TypeScript. I led the design-system rebuild at Pazarbox, care about performance budgets and localization, and like working closely with designers and product managers on measurable outcomes.</p></div></div></section><section class="cv-section" data-cv-section="work" data-cv-path="/work"><div class="cv-keep"><h2 class="cv-heading">EXPERIENCE</h2><article class="cv-entry is-short" data-cv-path="/work/0"><div class="cv-entry-head"><h3 class="cv-entry-title"><span class="cv-entry-role" data-cv-path="/work/0/position">Frontend Engineer</span><span class="cv-entry-org">, </span><span class="cv-entry-org" data-cv-path="/work/0/name">Pazarbox</span></h3><span class="cv-dates">Mar 2022 – Present</span></div><p class="cv-entry-sub"><span class="cv-entry-location" data-cv-path="/work/0/location">Istanbul, Türkiye</span></p><p class="cv-entry-summary" data-cv-path="/work/0/summary">E-commerce marketplace with 4M monthly shoppers; member of the checkout and platform squads.</p><ul class="cv-bullets"><li data-cv-path="/work/0/highlights/0">Led the rebuild of the design system (62 components, React + TypeScript, Storybook), adopted by 7 product teams.</li><li data-cv-path="/work/0/highlights/1">Cut checkout Largest Contentful Paint from 3.9 s to 1.8 s through code splitting and image budgets.</li><li data-cv-path="/work/0/highlights/2">Introduced Playwright visual tests that caught 40+ regressions before release in the first quarter.</li><li data-cv-path="/work/0/highlights/3">Shipped right-to-left and Arabic localization for the Gulf expansion together with the i18n guild.</li></ul></article></div><article class="cv-entry is-short" data-cv-path="/work/1"><div class="cv-entry-head"><h3 class="cv-entry-title"><span class="cv-entry-role" data-cv-path="/work/1/position">Frontend Developer</span><span class="cv-entry-org">, </span><span class="cv-entry-org" data-cv-path="/work/1/name">Kuzey Labs</span></h3><span class="cv-dates">Feb 2020 – Feb 2022</span></div><p class="cv-entry-sub"><span class="cv-entry-location" data-cv-path="/work/1/location">Istanbul, Türkiye</span></p><p class="cv-entry-summary" data-cv-path="/work/1/summary">Product studio building web and mobile apps for fintech and logistics clients.</p><ul class="cv-bullets"><li data-cv-path="/work/1/highlights/0">Built a React Native driver app for a logistics client, used by 3,500 drivers daily.</li><li data-cv-path="/work/1/highlights/1">Delivered a GraphQL-backed portfolio dashboard for a Turkish neobank in four months.</li></ul></article><article class="cv-entry is-short" data-cv-path="/work/2"><div class="cv-entry-head"><h3 class="cv-entry-title"><span class="cv-entry-role" data-cv-path="/work/2/position">Junior Web Developer</span><span class="cv-entry-org">, </span><span class="cv-entry-org" data-cv-path="/work/2/name">Mavi Yazılım</span></h3><span class="cv-dates">Jul 2019 – Jan 2020</span></div><p class="cv-entry-sub"><span class="cv-entry-location" data-cv-path="/work/2/location">Istanbul, Türkiye</span></p><ul class="cv-bullets"><li data-cv-path="/work/2/highlights/0">Maintained customer-facing booking forms and raised their Lighthouse accessibility score to 98.</li></ul></article></section><section class="cv-section" data-cv-section="projects" data-cv-path="/projects"><div class="cv-keep"><h2 class="cv-heading">PROJECTS</h2><article class="cv-entry is-short" data-cv-path="/projects/0"><div class="cv-entry-head"><h3 class="cv-entry-title"><span class="cv-entry-role" data-cv-path="/projects/0/name">tiny-i18n-lint</span><span class="cv-entry-org">, </span><span class="cv-entry-org" data-cv-path="/projects/0">Author · Maintainer</span></h3><span class="cv-dates">Jan 2024 – Present</span></div><p class="cv-entry-sub"><span class="cv-link"><a href="https://github.com/deniz-aksoy-example/tiny-i18n-lint" data-cv-path="/projects/0/url">github.com/deniz-aksoy-example/tiny-i18n-lint</a></span></p><p class="cv-entry-summary" data-cv-path="/projects/0/description">ESLint plugin that flags hard-coded UI strings and missing translation keys.</p><ul class="cv-bullets"><li data-cv-path="/projects/0/highlights/0">1.2k weekly npm downloads</li><li data-cv-path="/projects/0/highlights/1">Used by two Istanbul startups in CI</li></ul></article></div></section><section class="cv-section" data-cv-section="skills" data-cv-path="/skills"><div class="cv-keep"><h2 class="cv-heading">SKILLS</h2><div class="cv-lines"><p data-cv-path="/skills/0"><span class="cv-line-label" data-cv-path="/skills/0/name">Frontend:</span> <span data-cv-path="/skills/0/keywords">React, TypeScript, Next.js, Redux, Tailwind CSS, Vite</span></p><p data-cv-path="/skills/1"><span class="cv-line-label" data-cv-path="/skills/1/name">Quality:</span> <span data-cv-path="/skills/1/keywords">Accessibility (WCAG 2.2), Web performance, Jest, Playwright, Storybook</span></p><p data-cv-path="/skills/2"><span class="cv-line-label" data-cv-path="/skills/2/name">Product:</span> <span data-cv-path="/skills/2/keywords">Design systems, Figma, A/B testing, Localization</span></p><p data-cv-path="/skills/3"><span class="cv-line-label" data-cv-path="/skills/3/name">Also:</span> <span data-cv-path="/skills/3/keywords">React Native, Node.js, GraphQL</span></p></div></div></section><section class="cv-section" data-cv-section="education" data-cv-path="/education"><div class="cv-keep"><h2 class="cv-heading">EDUCATION</h2><article class="cv-entry is-short" data-cv-path="/education/0"><div class="cv-entry-head"><h3 class="cv-entry-title"><span class="cv-entry-role" data-cv-path="/education/0">BSc, Computer Engineering</span><span class="cv-entry-org">, </span><span class="cv-entry-org" data-cv-path="/education/0/institution">Istanbul Technical University</span></h3><span class="cv-dates">Sep 2015 – Jun 2019</span></div></article></div></section><section class="cv-section" data-cv-section="languages" data-cv-path="/languages"><div class="cv-keep"><h2 class="cv-heading">LANGUAGES</h2><div class="cv-lines"><p data-cv-path="/languages/0"><span class="cv-line-label" data-cv-path="/languages/0/language">Turkish:</span> <span data-cv-path="/languages/0/fluency">Native</span></p><p data-cv-path="/languages/1"><span class