    "apply.tailor.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude liest die Stellenbeschreibung und schlägt Änderungen an diesem Lebenslauf vor. Es formuliert nur um, ordnet neu oder hebt hervor, was schon in deinem Lebenslauf steht. Bis du speicherst, ändert sich nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude reads the job description and suggests edits to this CV. It only rewords, reorders or emphasises what your CV already says. Nothing changes until you save."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude ilan metnini okur ve bu CV için düzenlemeler önerir. Yalnızca CV'nizde zaten yazanları yeniden ifade eder, sıralar veya öne çıkarır. Kaydedene kadar hiçbir şey değişmez."
          }
        }
      }
    },
