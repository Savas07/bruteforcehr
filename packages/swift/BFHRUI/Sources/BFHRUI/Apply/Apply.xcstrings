    "apply.email.defaultBody" : {
      "comment" : "Default email body. %1$@ = job title, %2$@ = company, %3$@ = the user's name (may be empty). Without a cover letter.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo,\n\nich möchte mich auf die Stelle %1$@ bei %2$@ bewerben. Mein CV ist angehängt.\n\nViele Grüße\n%3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hello,\n\nI'd like to apply for the %1$@ role at %2$@. My CV is attached.\n\nKind regards,\n%3$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merhaba,\n\n%2$@ şirketindeki %1$@ pozisyonuna başvurmak istiyorum. CV'm ektedir.\n\nSaygılarımla,\n%3$@"
          }
        }
      }
    },
    "apply.email.defaultBodyWithLetter" : {
      "comment" : "Default email body. %1$@ = job title, %2$@ = company, %3$@ = the user's name (may be empty). With a cover letter attached.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo,\n\nich möchte mich auf die Stelle %1$@ bei %2$@ bewerben. Mein CV und mein Anschreiben sind angehängt.\n\nViele Grüße\n%3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hello,\n\nI'd like to apply for the %1$@ role at %2$@. My CV and cover letter are attached.\n\nKind regards,\n%3$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merhaba,\n\n%2$@ şirketindeki %1$@ pozisyonuna başvurmak istiyorum. CV'm ve ön yazım ektedir.\n\nSaygılarımla,\n%3$@"
          }
        }
      }
    },
