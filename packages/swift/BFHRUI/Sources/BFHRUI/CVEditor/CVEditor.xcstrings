    "cvEditor.empty.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere deinen vorhandenen Lebenslauf oder starte mit einem leeren. Versionen für Rollen oder Sprachen kannst du später anlegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import the CV you already have, or start from a blank one. You can make versions for each role or language later."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elinizdeki CV'yi içe aktarın ya da boş bir CV ile başlayın. Her pozisyon veya dil için sürümleri daha sonra oluşturabilirsiniz."
          }
