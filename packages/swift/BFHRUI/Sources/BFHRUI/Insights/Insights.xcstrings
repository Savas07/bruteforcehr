    "insights.def.response" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Antwort vom Arbeitgeber: ein Wechsel zu Vorauswahl, Gespräch, Angebot oder Nicht ausgewählt oder eine verknüpfte E-Mail mit Einladung, Rückfrage oder Entscheidung. Automatische Eingangsbestätigungen zählen nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reply from the employer: a move to Screening, Interviewing, Offer or Not selected, or a linked email that invites you, asks for something or decides. Automatic receipts don't count."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşverenden bir yanıt: Ön görüşme, Mülakat, Teklif veya Seçilmedi aşamasına geçiş ya da sizi davet eden, bir şey isteyen veya karar bildiren bağlı bir e-posta. Otomatik alındı bildirimleri sayılmaz."
          }
        }
      }
    },
