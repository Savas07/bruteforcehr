    "jobDetail.breakdown.explainer.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir vergleichen die Anzeige mit deinem Lebenslauf und deinen Wünschen. Zuerst zählen Anforderungen wie Ort, Remote-Arbeit und Gehalt, dann Skills und Erfahrung. Jede Zeile zeigt den Text aus der Anzeige oder deinem Lebenslauf, auf dem sie beruht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We compare the posting with your CV and your preferences. Requirements like location, remote work and salary count first, then skills and experience. Each line shows the text from the posting or your CV behind it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlanı CV'nizle ve tercihlerinizle karşılaştırıyoruz. Önce konum, uzaktan çalışma ve maaş gibi koşullar, ardından beceriler ve deneyim sayılır. Her satır, dayandığı ilan ya da CV metnini gösterir."
          }
        }
      }
    },
    "jobDetail.breakdown.explainer.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
