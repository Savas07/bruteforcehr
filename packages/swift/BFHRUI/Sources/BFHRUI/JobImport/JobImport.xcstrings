    "share.blockedMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche Jobbörsen zeigen Anzeigen nur nach dem Anmelden oder nach einer Prüfung, an der wir nicht vorbeikommen. Trag den Job selbst ein, der Link bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some job boards show postings only after signing in or a check we don't get past. Add the job by hand instead; the link is kept."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı iş siteleri ilanları yalnızca giriş yapınca ya da geçemediğimiz bir kontrolden sonra gösterir. İlanı elle ekleyin; bağlantı saklanır."
          }
        }
      }
    },
