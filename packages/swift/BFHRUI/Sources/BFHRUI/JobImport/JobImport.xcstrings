    "share.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern legt den Job unter Jobs › Gespeichert ab. Als beworben eintragen fügt ihn zusätzlich mit heutigem Datum als Beworben in deinen Tracker ein. Beides kannst du später ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save keeps it in Jobs › Saved. Log as applied also adds it to your Tracker as Applied today. You can change both later."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydet, ilanı İşler › Kaydedilenler'de tutar. Başvurdum olarak eklerseniz Takip'e bugünün tarihiyle Başvuruldu olarak da eklenir. İkisini de sonra değiştirebilirsiniz."
