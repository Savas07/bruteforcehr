    "share.aiOffMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-Funktionen sind in deinen Einstellungen aus. Trag den Job selbst ein oder schalte KI in der App ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI features are turned off in your settings. Add the job by hand, or turn AI on in the app."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâ özellikleri ayarlarınızda kapalı. İlanı elle ekleyin ya da uygulamada yapay zekâyı açın."
          }
        }
      }
    },
