    "connect.trust" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine E-Mails bleiben privat. Wir behalten nur Job-E-Mails, und du kannst jederzeit trennen und alles löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your mail stays private. We keep only job-related messages, and you can disconnect and delete everything anytime."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-postalarınız gizli kalır. Yalnızca işle ilgili iletileri saklarız; istediğiniz zaman bağlantıyı kesip her şeyi silebilirsiniz."
          }
        }
      }
    },
    "error.accountGone" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto wurde getrennt. Füge es in den Einstellungen wieder hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account was disconnected. Add it again from Settings."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hesabın bağlantısı kesildi. Ayarlar'dan yeniden ekleyin."
          }
        }
      }
    },
    "error.admin" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Organisation muss BruteForceHR freigeben, bevor es dieses Postfach lesen kann. Frag deine IT oder verbinde stattdessen ein privates Konto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your organization needs to approve BruteForceHR before it can read this mailbox. Ask your IT admin, or connect a personal account instead."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu posta kutusunu okuyabilmesi için kuruluşunuzun BruteForceHR'ı onaylaması gerekiyor. BT yöneticinize sorun ya da kişisel bir hesap bağlayın."
          }
        }
      }
    },
    "error.expired" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung hat zu lange gedauert. Versuch es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in took too long. Try again."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş çok uzun sürdü. Tekrar deneyin."
          }
        }
      }
    },
    "error.failed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten die Verbindung nicht abschließen. Es wurde nichts gespeichert. Versuch es gleich noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't finish connecting. Nothing was saved. Try again in a moment."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantıyı tamamlayamadık. Hiçbir şey kaydedilmedi. Biraz sonra tekrar deneyin."
          }
        }
      }
    },
    "error.offline" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Zum Verbinden brauchst du eine Internetverbindung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're offline. Connecting needs an internet connection."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimdışısınız. Bağlanmak için internet bağlantısı gerekiyor."
          }
        }
      }
    },
    "error.scope" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BruteForceHR hat keine Berechtigung erhalten, deine E-Mails zu lesen. Versuch es noch einmal und lass die Mail-Berechtigung angehakt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BruteForceHR didn't get permission to read your email. Try again and keep the mail permission checked."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BruteForceHR e-postalarınızı okuma izni alamadı. Tekrar deneyin ve e-posta iznini işaretli bırakın."
          }
        }
      }
    },
    "error.unverified" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige zuerst deine Anmelde-E-Mail und versuch es dann noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirm your sign-in email first, then try again."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce giriş e-postanızı onaylayın, sonra tekrar deneyin."
          }
        }
      }
    },
    "error.wrongUser" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anmeldung gehört zu einem anderen BruteForceHR-Konto, deshalb wurde nichts gespeichert. Versuch es noch einmal aus diesem Konto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That sign-in belongs to another BruteForceHR account, so nothing was saved. Try again from this account."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu giriş başka bir BruteForceHR hesabına ait, bu yüzden hiçbir şey kaydedilmedi. Bu hesaptan tekrar deneyin."
          }
        }
      }
    },
