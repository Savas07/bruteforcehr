        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disconnect anytime."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstediğiniz zaman bağlantıyı kesin."
          }
        }
      }
    },
    "oauth.promise.find.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir suchen nach Nachrichten von Arbeitgebern und Jobportalen. Andere E-Mails überspringen wir und speichern sie nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We look for messages from employers and job sites. Other emails are skipped, and we never store them."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşverenlerden ve iş sitelerinden gelen iletileri ararız. Diğer e-postaları atlarız ve asla saklamayız."
          }
        }
      }
    },
    "oauth.promise.find.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet Job-E-Mails."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds job emails."
          }
        },
        "tr" : {
