    "oauth.expectation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fragt, worauf BruteForceHR zugreifen darf. Lass „%2$@“ angehakt, sonst finden wir deine Bewerbungen nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ will ask what BruteForceHR can access. Keep “%2$@” checked, or we can't find your applications."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, BruteForceHR'ın nelere erişebileceğini soracak. “%2$@” seçeneğini işaretli bırakın; yoksa başvurularınızı bulamayız."
          }
        }
      }
    },
    "oauth.keepAccess" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft fragt auch, ob der Zugriff bestehen bleiben darf. So können wir alle paar Minuten nach neuen E-Mails schauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft also asks to keep access. That lets us check for new emails every few minutes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft erişimi sürdürmek için de izin ister. Böylece yeni e-postaları birkaç dakikada bir kontrol edebiliriz."
          }
        }
      }
    },
    "oauth.notConfigured.google" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst Gmail jetzt mit einem App-Passwort verbinden. Das dauert etwa zwei Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can connect Gmail now with an app password instead. It takes about two minutes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gmail'i şimdi bir uygulama şifresiyle bağlayabilirsiniz. Yaklaşık iki dakika sürer."
          }
        }
      }
    },
    "oauth.notConfigured.microsoft" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outlook.com erlaubt nur die Microsoft-Anmeldung, also klappt es, sobald die eingeschaltet ist. Andere Anbieter funktionieren schon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outlook.com only allows Microsoft sign-in, so it will work once that's turned on. Other providers work now."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outlook.com yalnızca Microsoft ile girişe izin verir; bu açıldığında çalışacak. Diğer sağlayıcılar şimdi çalışıyor."
          }
        }
      }
    },
    "oauth.notConfigured.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
