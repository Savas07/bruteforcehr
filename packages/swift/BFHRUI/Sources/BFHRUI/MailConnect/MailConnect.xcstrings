    "connect.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir suchen nach Bewerbungsbestätigungen, Interview-Einladungen und Antworten von Arbeitgebern und schlagen dir Updates vor, die du bestätigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We look for application confirmations, interview invites and replies from employers, then suggest updates you confirm."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başvuru onaylarını, mülakat davetlerini ve işverenlerden gelen yanıtları buluruz; ardından sizin onaylayacağınız güncellemeler öneririz."
          }
        }
      }
    },
