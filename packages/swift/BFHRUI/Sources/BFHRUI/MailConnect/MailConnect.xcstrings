    "imap.error.auth" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesem App-Passwort konnten wir uns nicht anmelden. Prüf, ob es vollständig kopiert wurde. Dein normales Passwort funktioniert hier nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't sign in with this app password. Check it was copied in full. Your regular password won't work here."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulama şifresiyle giriş yapamadık. Tamamen kopyalandığını kontrol edin. Normal şifreniz burada çalışmaz."
          }
        }
      }
    },
    "imap.error.host" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist über Port %2$lld nicht erreichbar. Prüf Servername und Port."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach %1$@ on port %2$lld. Check the server name and port."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sunucusuna %2$lld portundan ulaşılamıyor. Sunucu adını ve portu kontrol edin."
          }
        }
      }
    },
    "imap.error.imapDisabled" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der IMAP-Zugriff ist für dieses Konto aus. Schalte ihn in den Mail-Einstellungen deines Anbieters ein und versuch es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IMAP access is turned off for this account. Turn it on in your provider's mail settings, then try again."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hesapta IMAP erişimi kapalı. Sağlayıcınızın e-posta ayarlarından açıp tekrar deneyin."
          }
        }
      }
    },
    "imap.error.tls" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Sicherheitszertifikat des Servers ließ sich nicht prüfen. Prüf die Sicherheitseinstellung oder frag deinen Anbieter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server's security certificate couldn't be verified. Check the security setting or ask your provider."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucunun güvenlik sertifikası doğrulanamadı. Güvenlik ayarını kontrol edin ya da sağlayıcınıza sorun."
          }
        }
      }
    },
