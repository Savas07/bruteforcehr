    "connect.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde deine E-Mail"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect your email"
