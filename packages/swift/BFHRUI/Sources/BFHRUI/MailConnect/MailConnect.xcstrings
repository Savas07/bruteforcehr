    "oauth.promise.ai.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir sortieren E-Mails nach Regeln. Nur wenn du es in den Einstellungen erlaubst, liest Anthropic Claude Job-E-Mails zum Sortieren. Nichts ändert sich ohne einen Grund, den du siehst und rückgängig machen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We sort emails with rules. Only if you allow it in Settings does Anthropic Claude read job emails to sort them. Nothing changes without a reason you can see and undo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-postaları kurallarla sınıflandırırız. Yalnızca Ayarlar'da izin verirseniz Anthropic Claude iş e-postalarını sınıflandırmak için okur. Görebileceğiniz ve geri alabileceğiniz bir neden olmadan hiçbir şey değişmez."
          }
        }
      }
    },
    "oauth.promise.ai.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du entscheidest über KI."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You decide about AI."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâ kararı sizde."
          }
        }
      }
    },
    "oauth.promise.disconnect.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir entfernen unseren Zugriff und löschen die E-Mail-Daten dieses Kontos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We remove our access and delete this account's mail data."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erişimimizi kaldırır ve bu hesabın e-posta verilerini sileriz."
          }
        }
      }
    },
    "oauth.promise.disconnect.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jederzeit trennen."
