    "mail.connect.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir lesen Job-Mails wie Einladungen und Antworten und halten deine Bewerbungen aktuell. Etwa 2 Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We read job emails, like interview invites and replies, and keep your applications up to date. About 2 minutes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mülakat davetleri ve yanıtlar gibi iş e-postalarını okuyup başvurularınızı güncel tutarız. Yaklaşık 2 dakika."
          }
        }
      }
    },
