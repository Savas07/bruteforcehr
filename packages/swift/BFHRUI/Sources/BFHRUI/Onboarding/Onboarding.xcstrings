    "onboarding.auth.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl unter „Wo“ ein Land, dann fragen wir hier danach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a country under Where and we'll ask about it here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nerede bölümünden bir ülke seçin, burada onu soralım."
          }
        }
      }
    },
    "onboarding.auth.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So zeigen wir dir Jobs, die du wirklich annehmen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This helps us show jobs you can actually take."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, gerçekten kabul edebileceğiniz işleri göstermemize yardımcı olur."
          }
        }
      }
    },
