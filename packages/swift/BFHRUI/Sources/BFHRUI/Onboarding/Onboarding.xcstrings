    "onboarding.auth.question": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darfst du ohne Sponsoring in %@ arbeiten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can you work in %@ without sponsorship?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ülkesinde sponsorluk olmadan çalışabiliyor musunuz?"
          }
        }
