    "onboarding.cv.ai": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Lebenslauf wird von KI (Anthropic Claude) gelesen, um dein Profil auszufüllen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your CV is read by AI (Anthropic Claude) to fill in your profile."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilinizi doldurmak için özgeçmişiniz yapay zekâ (Anthropic Claude) tarafından okunur."
          }
        }
      }
    },
    "onboarding.cv.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir füllen damit dein Profil und deine Wünsche aus. Du kannst später alles ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll use it to fill in your profile and preferences. You can change everything later."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilinizi ve tercihlerinizi doldurmak için kullanacağız. Her şeyi daha sonra değiştirebilirsiniz."
          }
        }
      }
    },
    "onboarding.cv.cancel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeç"
          }
        }
      }
    },
    "onboarding.cv.chooseDifferent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Datei wählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a different file"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir dosya seçin"
          }
        }
      }
    },
    "onboarding.cv.error.aiDisabled": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI ist ausgeschaltet, deshalb können wir diese Datei nicht lesen. Fang stattdessen neu an oder schalte KI in den Einstellungen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is turned off, so we can't read this file. Start from scratch instead, or turn AI on in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekâ kapalı olduğu için bu dosyayı okuyamıyoruz. Sıfırdan başlayın veya Ayarlar'dan yapay zekâyı açın."
          }
        }
      }
    },
    "onboarding.cv.error.dailyLimit": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast heute schon mehrere Lebensläufe importiert. Versuch es morgen wieder oder fang neu an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've imported several CVs today. Try again tomorrow, or start from scratch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün birkaç özgeçmiş içe aktardınız. Yarın tekrar deneyin veya sıfırdan başlayın."
          }
        }
      }
    },
    "onboarding.cv.error.offline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Upload wurde nicht abgeschlossen. Prüf deine Verbindung und versuch es noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload didn't finish. Check your connection and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükleme tamamlanmadı. Bağlantınızı kontrol edip tekrar deneyin."
          }
        }
      }
    },
    "onboarding.cv.error.other": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Lesen dieser Datei ist etwas schiefgelaufen. Versuch es noch mal oder fang neu an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong while reading this file. Try again, or start from scratch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya okunurken bir sorun oluştu. Tekrar deneyin veya sıfırdan başlayın."
          }
        }
      }
    },
    "onboarding.cv.error.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist größer als 20 MB. Versuch, ein kleineres PDF zu exportieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is over 20 MB. Try exporting a smaller PDF."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya 20 MB'tan büyük. Daha küçük bir PDF dışa aktarmayı deneyin."
          }
        }
      }
    },
    "onboarding.cv.error.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten in dieser Datei keinen Text lesen. Vielleicht ist sie ein Scan. Versuch es mit einer DOCX oder fang neu an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't read text in this file. It may be a scan. Try a DOCX, or start from scratch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosyadaki metni okuyamadık. Taranmış bir belge olabilir. DOCX deneyin veya sıfırdan başlayın."
          }
        }
      }
    },
    "onboarding.cv.error.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Dateityp wird nicht unterstützt. Nimm PDF, DOCX, JSON Resume oder die LinkedIn-ZIP."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file type isn't supported. Use PDF, DOCX, JSON Resume or the LinkedIn ZIP."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya türü desteklenmiyor. PDF, DOCX, JSON Resume veya LinkedIn ZIP dosyası kullanın."
          }
        }
      }
    },
    "onboarding.cv.found": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Rollen und %2$lld Fähigkeiten gefunden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found %1$lld roles and %2$lld skills"
          }
