            "value": "%1$lld pozisyon ve %2$lld beceri bulundu"
          }
        }
      }
    },
    "onboarding.cv.linkedin": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LinkedIn-Export importieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import LinkedIn export"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LinkedIn dışa aktarımını içe aktarın"
          }
        }
      }
