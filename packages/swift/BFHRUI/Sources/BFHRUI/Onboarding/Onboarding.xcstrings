    },
    "onboarding.auth.question.eu": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darfst du ohne Sponsoring in der EU / im EWR arbeiten?"
