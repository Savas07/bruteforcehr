{
  "sourceLanguage": "en",
  "strings": {
    "jobPreferences.answered": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld beantwortet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld answered"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld yanıtlandı"
          }
        }
      }
    },
    "jobPreferences.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie bestimmen deine Treffer und gespeicherten Suchen. Änderungen gelten ab dem nächsten Suchlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These shape your matches and your saved searches. Changes count from the next time your searches run."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşmelerinizi ve kayıtlı aramalarınızı bunlar belirler. Değişiklikler, aramalarınız bir sonraki çalıştığında geçerli olur."
          }
        }
      }
    },
    "jobPreferences.loading": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Wünsche werden geladen …"
          }
