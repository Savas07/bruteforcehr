        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading your preferences…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tercihleriniz yükleniyor…"
          }
        }
      }
    },
