    "onboarding.cv.linkedin.caption": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ZIP-Datei, die LinkedIn dir per E-Mail schickt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ZIP file LinkedIn emails you"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LinkedIn'in size e-postayla gönderdiği ZIP dosyası"
          }
        }
      }
    },
    "onboarding.cv.linkedin.howTo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So bekommst du sie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to get it"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl alınır?"
          }
        }
      }
    },
    "onboarding.cv.linkedin.howTo.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in LinkedIn Einstellungen › Datenschutz › Kopie deiner Daten anfordern und fordere das größere Archiv an. LinkedIn schickt dir meist innerhalb eines Tages einen Download-Link per E-Mail. Speichere die ZIP-Datei in „Dateien“ und importiere sie dann hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In LinkedIn, open Settings › Data privacy › Get a copy of your data, and request the larger archive. LinkedIn emails you a download link, usually within a day. Save the ZIP to Files, then import it here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LinkedIn'de Ayarlar › Veri gizliliği › Verilerinizin bir kopyasını alın bölümünü açın ve büyük arşivi isteyin. LinkedIn size genellikle bir gün içinde bir indirme bağlantısı gönderir. ZIP dosyasını Dosyalar'a kaydedin, ardından buradan içe aktarın."
          }
        }
      }
    },
    "onboarding.cv.linkedin.howTo.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine LinkedIn-Daten holen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get your LinkedIn data"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LinkedIn verilerinizi alın"
          }
        }
      }
    },
