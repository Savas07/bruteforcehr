        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SİL"
          }
        }
      }
    },
    "dataPrivacy.delete.description" : {
      "comment" : "Footer under the Delete account row.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche dein Konto und alles, was damit gespeichert ist, endgültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently delete your account and everything stored with it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınızı ve onunla birlikte saklanan her şeyi kalıcı olarak silin."
          }
        }
      }
    },
    "dataPrivacy.delete.dialog.lead" : {
      "comment" : "Introduces the list of what is deleted.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endgültig gelöscht werden:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalıcı olarak silinecekler:"
          }
        }
      }
    },
    "dataPrivacy.delete.dialog.title" : {
      "comment" : "Heading of the deletion screen.",
      "extractionState" : "manual",
