    "dataPrivacy.export.error.tooLarge" : {
      "comment" : "Export refused: more than 300 MB. Support is GitHub issues only.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten sind zu groß für einen Export. Bitte eröffne ein Issue auf GitHub, dann helfen wir dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data is too large for one export. Please open an issue on GitHub and we'll help."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verileriniz tek bir dışa aktarım için çok büyük. Lütfen GitHub'da bir kayıt açın, yardımcı olalım."
          }
        }
      }
    },
