        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınız ve tüm verileri silindi."
          }
        }
      }
    },
    "dataPrivacy.delete.error.generic" : {
      "comment" : "Deletion failed part-way; Delete everything resumes.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen wurde nicht abgeschlossen. Versuche es noch einmal; es geht dort weiter, wo es aufgehört hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletion didn't finish. Try again; it continues where it stopped."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silme işlemi tamamlanmadı. Tekrar deneyin; kaldığı yerden devam eder."
          }
        }
      }
    },
