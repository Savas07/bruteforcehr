          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekrar dene"
          }
        }
      }
    },
    "dataPrivacy.delete.confirm.label" : {
      "comment" : "Label above the confirmation field. %@ = the confirm word (delete.confirm.word), in bold (keep the asterisks).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib zur Bestätigung **%@** ein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To confirm, type **%@**"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onaylamak için **%@** yazın"
          }
        }
      }
    },
    "dataPrivacy.delete.confirm.word" : {
      "comment" : "The word to type to confirm. Upper case; any case is accepted.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LÖSCHEN"
          }
