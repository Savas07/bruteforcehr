    "dataPrivacy.delete.reauth.body" : {
      "comment" : "Why a link is needed. %@ = the signed-in email address, in bold (keep the asterisks).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu deiner Sicherheit schicken wir einen Anmeldelink an **%@**. Öffne ihn auf diesem Gerät und schließe dann hier ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For your security, we'll email a sign-in link to **%@**. Open it on this device, then finish here."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenliğiniz için **%@** adresine bir giriş bağlantısı göndereceğiz. Bağlantıyı bu cihazda açın, ardından burada tamamlayın."
          }
        }
      }
    },
