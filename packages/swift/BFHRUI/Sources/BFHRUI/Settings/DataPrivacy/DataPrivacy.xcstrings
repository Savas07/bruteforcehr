    "dataPrivacy.delete.done" : {
      "comment" : "Calm notice on the welcome screen after the deletion, shown once.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto und alle zugehörigen Daten wurden gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account and all its data were deleted."
