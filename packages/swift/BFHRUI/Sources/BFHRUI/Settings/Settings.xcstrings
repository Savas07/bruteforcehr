    "account.disconnect.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir prüfen dieses Postfach nicht mehr, entfernen unseren Zugriff und löschen die daraus gespeicherten Job-E-Mails (%lld). Deine Bewerbungen und ihr Verlauf bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll stop checking this inbox, remove our access, and delete the job emails we stored from it (%lld). Your applications and their history stay."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu gelen kutusunu kontrol etmeyi bırakacak, erişimimizi kaldıracak ve buradan sakladığımız iş e-postalarını (%lld) sileceğiz. Başvurularınız ve geçmişleri kalır."
          }
        }
      }
    },
