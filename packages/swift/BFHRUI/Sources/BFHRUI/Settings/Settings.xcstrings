    "ai.enabled" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-Funktionen verwenden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use AI features"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâ özelliklerini kullan"
          }
        }
      }
    },
    "ai.enabled.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird genutzt, um Treffer zu erklären, beim Anpassen von Lebensläufen zu helfen und, wenn du es unten erlaubst, Job-E-Mails zu sortieren. Die KI erfindet keine Lebenslauf-Inhalte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to explain matches, help tailor CVs and, if you allow it below, sort job emails. AI never invents CV content."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşleşmeleri açıklamak, CV'leri uyarlamaya yardım etmek ve aşağıda izin verirseniz iş e-postalarını sınıflandırmak için kullanılır. Yapay zekâ CV içeriği uydurmaz."
          }
        }
      }
    },
    "ai.mailText" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senden von E-Mail-Text an die KI erlauben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow sending email text to AI"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-posta metninin yapay zekâya gönderilmesine izin ver"
          }
        }
      }
    },
    "ai.mailText.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Job-E-Mails, und nur die Teile, die zum Sortieren nötig sind, gehen an Anthropic, das damit nicht trainiert. Wenn aus, sortieren wir nur nach Regeln, und mehr E-Mails brauchen deine Prüfung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only job-related emails, and only the parts needed to sort them, go to Anthropic, which doesn't train on this data. When off, we sort with rules only, so more emails will ask for your review."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca işle ilgili e-postaların, sınıflandırma için gereken kısımları Anthropic'e gider; Anthropic bu verilerle model eğitmez. Kapalıyken yalnızca kurallarla sınıflandırırız, bu yüzden daha fazla e-posta incelemenizi ister."
          }
        }
      }
    },
    "ai.provider" : {
