    "sources.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobquellen laufen für jede gespeicherte Suche auf unserem Server. Eine Quelle mit Problemen setzt einen Lauf aus; die anderen arbeiten weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Job sources run on our server for every saved search. A source with trouble skips a run; the others keep working."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlan kaynakları, her kayıtlı arama için sunucumuzda çalışır. Sorun yaşayan bir kaynak o çalıştırmayı atlar; diğerleri çalışmaya devam eder."
          }
        }
      }
