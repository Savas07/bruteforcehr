    "account.actionFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das hat nicht geklappt. Prüf deine Verbindung und versuch es noch einmal."
          }
