          }
        }
      }
    },
    "signIn.link.retry.offline" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du scheinst offline zu sein. Prüf deine Verbindung und versuch es noch einmal. Dein Link gilt weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You seem to be offline. Check your connection and try again. Your link still works."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimdışı görünüyorsunuz. Bağlantınızı kontrol edip tekrar deneyin. Bağlantınız hâlâ geçerli."
          }
        }
      }
    },
    "signIn.link.retry.other" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei uns ist etwas schiefgelaufen. Versuch es gleich noch einmal. Dein Link gilt weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong on our side. Try again in a moment. Your link still works."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bizim tarafımızda bir sorun oluştu. Biraz sonra tekrar deneyin. Bağlantınız hâlâ geçerli."
          }
        }
      }
    },
