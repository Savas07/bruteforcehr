    "signIn.link.disabled.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dieser Adresse ist die Anmeldung gerade nicht möglich. Hol dir Hilfe, falls du das nicht erwartet hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing in isn't possible with this address right now. Get help if you didn't expect this."
