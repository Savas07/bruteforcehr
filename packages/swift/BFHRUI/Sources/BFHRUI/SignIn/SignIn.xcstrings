    "signIn.legal" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du fortfährst, stimmst du den [Nutzungsbedingungen](https://bruteforcehr.web.app/terms/) und der [Datenschutzerklärung](https://bruteforcehr.web.app/privacy/) zu."
