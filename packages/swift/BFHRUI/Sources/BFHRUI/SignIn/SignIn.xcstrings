    "signIn.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir schicken dir einen Anmeldelink per E-Mail. Kein Passwort nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll email you a link to sign in. No password needed."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş yapmanız için size e-postayla bir bağlantı göndereceğiz. Şifreye gerek yok."
          }
        }
      }
    },
    "signIn.check.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
