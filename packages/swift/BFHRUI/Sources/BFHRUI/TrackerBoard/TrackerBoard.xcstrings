    "tracker.notifications.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BruteForceHR kann dir zu den Zeiten, die du festlegst, eine Mitteilung schicken: eine Erinnerung zu einer Bewerbung oder die Vorbereitung vor einem Gespräch. Sonst nichts und nie zu Zeiten, die du nicht gewählt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BruteForceHR can notify you at the times you set: a reminder on an application, or prep before an interview. Nothing else, and never at times you didn't choose."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BruteForceHR yalnızca sizin belirlediğiniz saatlerde bildirim gönderebilir: bir başvurudaki hatırlatıcı ya da mülakat öncesi hazırlık. Başka bir şey değil, seçmediğiniz saatlerde de asla."
